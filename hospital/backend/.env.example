# FedCare AI Hospital Node Environment Variables

APP_NAME="FedCare AI Hospital Node"
APP_VERSION="1.0.0"
DEBUG=True

# SQLite local database url (isolated from central.db)
DATABASE_URL="sqlite+aiosqlite:///./hospital.db"

# JWT configuration
SECRET_KEY="fedcare-ai-hospital-node-super-secret-key-2026"
