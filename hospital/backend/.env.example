ACCESS_TOKEN_EXPIRE_MINUTES=120

# Hospital identity configuration
HOSPITAL_ID=1

# Coordinator location
CENTRAL_API_URL="http://localhost:8000"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5174", "http://localhost:3000"]
